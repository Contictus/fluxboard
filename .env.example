# Copy to .env (gitignored) before `make up`. Values below are LOCAL DEV
# defaults and match deploy/postgres/init/01-roles.sql. Never use in prod.
# Hostnames are compose service names (api/worker run inside the network).

# --- app ---
APP_ENV=dev
HTTP_ADDR=:8080
WORKER_METRICS_ADDR=:8081
WEB_ORIGIN=http://localhost:3000

# --- postgres (superuser used only for cluster init) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=postgres
POSTGRES_DB=fluxboard
# app role (runtime, RLS-subject) and owner role (migrations, DDL)
DATABASE_URL=postgres://fluxboard_app:app_pw@postgres:5432/fluxboard?sslmode=disable
DATABASE_URL_MIGRATE=postgres://fluxboard_owner:owner_pw@postgres:5432/fluxboard?sslmode=disable

# --- redis ---
REDIS_ADDR=redis:6379

# --- auth (Phase 1) ---
# ES256 private key PEM (single line with \n, or mount a file). Empty in Phase 0.
JWT_PRIVATE_KEY_PEM=
# 32-byte base64 key for AES-GCM TOTP secret encryption.
# Empty => 2FA endpoints are disabled. Generate: openssl rand -base64 32
TOTP_ENC_KEY=
# Google OAuth2 (PKCE). Empty client id/secret => the Google login routes 403.
# Redirect URL must be registered in the Google Cloud console for this client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:58080/api/v1/auth/oauth/google/callback

# --- billing (Phase 4) ---
# STRIPE_MODE defaults to "stub" (dev fake, no Stripe account). Under stub the
# webhook secret is the shared HMAC key for crafted payloads (X-Stub-Signature)
# — it must be non-empty or every webhook is rejected (fail closed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_stub_dev

# --- object storage (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fluxboard
MINIO_USE_SSL=false

# --- mail (Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fluxboard.local

# --- observability ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- build ---
GIT_SHA=dev

# --- host port publishing (change if a port clashes with another project) ---
# These affect only the host<->container mapping; in-network hostnames/ports
# (e.g. DATABASE_URL -> postgres:5432) are unchanged.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
API_HOST_PORT=8080
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
ASYNQMON_HOST_PORT=8082
